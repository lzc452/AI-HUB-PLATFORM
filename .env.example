NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgres://ai_hub:ai_hub_local_only@postgres:5432/ai_hub
COOKIE_SECRET=replace-with-a-secret-of-at-least-32-characters
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_DURATION_MS=900000
WORKER_METRICS_PORT=9464
ARTIFACT_UPLOAD_ENABLED=true
ARTIFACT_MAX_SIZE_BYTES=67108864
OBJECT_STORAGE_DRIVER=garage
OBJECT_STORAGE_ENDPOINT=http://garage:3900
OBJECT_STORAGE_REGION=garage
OBJECT_STORAGE_BUCKET=ai-hub
OBJECT_STORAGE_ACCESS_KEY=GKAIHUBLOCALDEVELOPMENT000000
OBJECT_STORAGE_SECRET_KEY=ai-hub-local-secret-key-replace-before-shared-use
OBJECT_STORAGE_FORCE_PATH_STYLE=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# 演示数据种子开关：seed:demo-data 仅在值为 true 时执行（compose.dev 的 api 容器 init:dev 同样需要）
DEMO_DATA_ENABLED=true
# 生产环境显式开启 API 文档（Swagger）时设为 true；开发/测试环境默认开启，无需设置
ENABLE_API_DOCS=false
POSTGRES_DB=ai_hub
POSTGRES_USER=ai_hub
POSTGRES_PASSWORD=ai_hub_local_only
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_ADMIN_TOKEN=ai-hub-local-admin-token
GARAGE_METRICS_TOKEN=ai-hub-local-metrics-token
GARAGE_DEFAULT_ACCESS_KEY=GKAIHUBLOCALDEVELOPMENT000000
GARAGE_DEFAULT_SECRET_KEY=ai-hub-local-secret-key-replace-before-shared-use
GARAGE_DEFAULT_BUCKET=ai-hub
