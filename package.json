{
  "name": "ai-hub-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "compat:node": "node --test scripts/check-web-tooling-node-compat.test.mjs",
    "dev:services": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait postgres garage clamav",
    "dev:api": "pnpm migrate && pnpm --filter @ai-hub/api dev",
    "dev:web": "pnpm --filter @ai-hub/web dev",
    "dev:worker": "pnpm --filter @ai-hub/worker dev",
    "boundaries": "dependency-cruiser apps packages --config dependency-cruiser.cjs",
    "governance:check": "node scripts/repository-governance.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "migrate": "tsx scripts/migrate.mts",
    "seed:demo-accounts": "tsx scripts/seed-demo-accounts.mts",
    "seed:demo-business": "tsx scripts/seed-demo-business.mts",
    "seed:demo-data": "tsx scripts/seed-demo-data.mts",
    "check:demo-data": "tsx scripts/check-demo-data.mts",
    "test:api-data": "vitest run --config apps/api/vitest.api-data.config.ts",
    "init:dev": "pnpm migrate && pnpm seed:demo-data && pnpm seed:demo-accounts",
    "init:production": "pnpm migrate",
    "test": "node --test scripts/*.test.mjs && turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "verify": "node scripts/verify.mjs"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@types/node": "18.19.130",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "semver": "7.7.4",
    "tsx": "4.23.1",
    "turbo": "2.5.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.0",
    "vitest": "3.2.4"
  }
}
