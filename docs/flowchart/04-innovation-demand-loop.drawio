<mxfile host="app.diagrams.net" agent="codex" version="24.0.0"><diagram id="04-innovation-demand-loop" name="创新需求闭环"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="提交创新需求" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="70" as="geometry" /></mxCell><mxCell id="p1" value="需求表单：业务场景 / 当前流程 / 痛点 / 影响对象与频率 / 期望结果&#10;替代方案 / 数据类型与敏感度 / 受众范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="120" as="geometry" /></mxCell><mxCell id="p2" value="轻量审核（创新运营管理员，SLA 1 个工作日）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="360" height="90" as="geometry" /></mxCell><mxCell id="d1" value="审核结果？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="300" height="100" as="geometry" /></mxCell><mxCell id="p3" value="待认领（全员可提交方案并表达偏好）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="320" height="90" as="geometry" /></mxCell><mxCell id="p4" value="运营确认认领（指定负责人 + 协作者）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="320" height="90" as="geometry" /></mxCell><mxCell id="p5" value="方案验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="320" height="70" as="geometry" /></mxCell><mxCell id="d2" value="试点结果？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="300" height="100" as="geometry" /></mxCell><mxCell id="p6" value="已转化为应用&#10;需求 ↔ 应用多对多关联" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="420" y="1050" width="360" height="90" as="geometry" /></mxCell><mxCell id="p7" value="已关闭（未转化 / 试点未达预期）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="420" y="1190" width="280" height="80" as="geometry" /></mxCell><mxCell id="p8" value="已驳回（必填原因，可修改后重新提交）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="280" height="90" as="geometry" /></mxCell><mxCell id="p9" value="已合并（重复需求合并，双源版本保护）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="440" y="630" width="280" height="80" as="geometry" /></mxCell><mxCell id="r1" value="需求状态机：草稿 → 待审核 → 待认领 → 已认领 → 方案验证中 → 试点中 → 已转化 / 已关闭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="560" height="150" as="geometry" /></mxCell><mxCell id="r2" value="互动与治理：点赞 / 匿名展示 / 一层讨论 / 举报（实名审计）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="560" height="130" as="geometry" /></mxCell><mxCell id="r3" value="通知：审核结果 / 认领 / 状态变化（站内 + 钉钉）" style="