<mxfile host="app.diagrams.net" agent="workbuddy" version="24.0.0"><diagram id="05-marketplace-interaction-governance" name="市场与互动治理"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="访问应用市场" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="240" height="70" as="geometry" /></mxCell><mxCell id="p1" value="受众权限过滤&#10;全员 / 指定部门含子部门 / 指定员工" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="320" height="90" as="geometry" /></mxCell><mxCell id="d1" value="在受众范围内？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="280" height="90" as="geometry" /></mxCell><mxCell id="p2" value="市场列表：推荐 / 最新 / 热门 / 分类 / 标签 / 类型筛&#10;选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="340" height="90" as="geometry" /></mxCell><mxCell id="p3" value="搜索：PostgreSQL 中文模糊 / 拼音全拼 / 首字母&#10;（权限条件随查询）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="360" height="90" as="geometry" /></mxCell><mxCell id="p4" value="应用详情：版本 / 风险声明 / 交付入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="320" height="80" as="geometry" /></mxCell><mxCell id="p5" value="交付入口：Web 跳转 / 安装包下载 / 小程序二维码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="340" height="90" as="geometry" /></mxCell><mxCell id="p6" value="不在受众范围内：列表 / 搜索 / 推荐 / 详情 / Dify / 导&#10;出均不可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1500" y="40" width="360" height="100" as="geometry" /></mxCell><mxCell id="r1" value="点赞（可取消，仅显示总数）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="160" width="400" height="80" as="geometry" /></mxCell><mxCell id="r2" value="评分与评价：1–5 星必填，文字可选&#10;可实名或匿名（跨版本保留）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="300" width="420" height="110" as="geometry" /></mxCell><mxCell id="r3" value="官方回复（仅责任人 / 维护人，回复一层）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="470" width="400" height="90" as="geometry" /></mxCell><mxCell id="r4" value="举报（员工 / 应用团队；举报不自动隐藏）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="620" width="400" height="80" as="geometry" /></mxCell><mxCell id="r5" value="管理员处理：驳回举报 / 隐藏 / 恢复（隐藏 ≠ 删除）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microso