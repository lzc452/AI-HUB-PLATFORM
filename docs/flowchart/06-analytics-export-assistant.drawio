<mxfile host="app.diagrams.net" agent="codex" version="24.0.0"><diagram id="06-analytics-export-assistant" name="数据看板与导出"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="用户行为产生（浏览 / 跳转 / 下载 / 二维码展示）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="280" height="80" as="geometry" /></mxCell><mxCell id="p1" value="行为事件采集：幂等写入 / UTC 分表 / 180 天保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="320" height="100" as="geometry" /></mxCell><mxCell id="p2" value="日聚合任务（12 版指标口径字典 → 预聚合表）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="320" height="90" as="geometry" /></mxCell><mxCell id="p3" value="固定看板：平台 / 市场 / 应用 / 创新 / 审核 / 部门 / 风险 / 运维" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="360" height="110" as="geometry" /></mxCell><mxCell id="p4" value="权限控制：责任人仅聚合数据，禁止查看个人访问名单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="360" height="100" as="geometry" /></mxCell><mxCell id="d1" value="导出或问答？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="300" height="100" as="geometry" /></mxCell><mxCell id="p5" value="后台导出：逐行审计 / 下载归属校验 / 短期授权地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#da