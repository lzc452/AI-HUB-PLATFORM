<mxfile host="app.diagrams.net" agent="workbuddy" version="24.0.0"><diagram id="07-v1-roadmap" name="V1 实施路线图"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ph1" value="Phase 1 · 工程基础与可运行骨架（第 1 月）&#10;monorepo / Compose / CI / 数据库基线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="130" as="geometry" /></mxCell><mxCell id="ph2" value="Phase 2 · 身份、组织与授权（第 2 月）&#10;账密 + 钉钉 OAuth / 组织同步 / RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="420" height="130" as="geometry" /></mxCell><mxCell id="ph3" value="Phase 3 · 应用、版本、交付与审核（第 3–4 月）&#10;四类应用 / 上传扫描 / 审核池 / 上下架" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="70" width="420" height="130" as="geometry" /></mxCell><mxCell id="ph4" value="Phase 4 · 市场、搜索、互动与创作者中心（第 5 月）&#10;权限过滤 / 搜索 / 评价举报 / 通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="70" width="440" height="130" as="geometry" /></mxCell><mxCell id="ph5" value="Phase 5 · AI 需求与创新广场（第 6 月）&#10;需求表单 / 轻量审核 / 认领 / 试点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="420" height="130" as="geometry" /></mxCell><mxCell id="ph6" value="Phase 6 · 分析、看板、导出与外部助手（第 7 月）&#10;行为事件 / 固定看板 / 导出 / Dify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="260" width="420" height="130" as="geometry" /></mxCell><mxCell id="ph7" value="Phase 7 · 生产安全、部署与运维（第 8 月）&#10;双机 Compose / 备份恢复 / 监控告警" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="260" width="420" height="130" as="geometry" /></mxCell><mxCell id="ph8" value="Phase 8 · 试点与正式上线（第 9 月）&#10;3–5 部门 / 30–50 员工 / UAT / 上线演练" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="260" width="440" height="130" as="geometry" /></mxCell><mxCell id="m1" value="M1：开发环境与 CI 可复现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="220" height="80" as="geometry" /></mxCell><mxCell id="m2" value="M2：认证、组织与权限通过安全测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="490" width="240" height="80" as="geometry" /></mxCell><mxCell id="m4" value="M4：四类应用发布审核闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="490" width="240" height="80" as="geometry" /></mxCell><mxCell id="m6" value="M6：应用市场与创新广场业务闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="490" width="250" height="80" as="geometry" /></mxCell><mxCell id="m7" value="M7：看板与外部集成完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="490" width="240" height="80" as="geometry" /></mxCell><mxCell id="m8" value="M8：Release Candidate 可部署" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="490" width="240" height="80" as="geometry" /></mxCell><mxCell id="m9" value="M9：试点验收与正式上线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1590" y="490" width="270" height="80" as="geometry" /></mxCell><mxCell id="c1" value="第 8 月功能冻结；新增功能默认进入 V1.1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="560" height="110" as="geometry" /></mxCell><mxCell id="c2" value="单企业 / 单实例 / 无 tenant_id；双机部署" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="690" width="560" height="110" as="geometry" /></mxCell><mxCell id="c3" value="每两周一个迭代；每次交付一条可演示端到端业务链" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft YaHei;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="690" width="620" height="110" as="geometry" /></mxCell><mxCell id="c4" value="安全 / 权限 / 审计 / 可观测随功能一同完成，不得第 8 月集中补做" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fff2cc