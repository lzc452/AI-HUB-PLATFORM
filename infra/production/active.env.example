# Copy to a host-only env file and replace every example value before deployment.
NODE_ROLE=active
PUBLIC_HOSTNAME=ai-hub.internal.example
PUBLIC_ORIGIN=https://ai-hub.internal.example
POSTGRES_DB=ai_hub
POSTGRES_USER=ai_hub
POSTGRES_CONFIG_FILE=/etc/ai-hub/postgres/primary.conf
PG_HBA_FILE=/etc/ai-hub/postgres/pg_hba.production.conf
WAL_ARCHIVE_PATH=/var/lib/ai-hub/wal-archive
API_IMAGE=registry.example/ai-hub-api@sha256:REPLACE_WITH_CI_DIGEST
WORKER_IMAGE=registry.example/ai-hub-worker@sha256:REPLACE_WITH_CI_DIGEST
WEB_IMAGE=registry.example/ai-hub-web@sha256:REPLACE_WITH_CI_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_APPROVED_DIGEST
GARAGE_IMAGE=garage@sha256:REPLACE_WITH_APPROVED_DIGEST
PROXY_IMAGE=nginx@sha256:REPLACE_WITH_APPROVED_DIGEST
CLAMAV_IMAGE=clamav@sha256:REPLACE_WITH_APPROVED_DIGEST
PROMETHEUS_IMAGE=prometheus@sha256:REPLACE_WITH_APPROVED_DIGEST
DATABASE_URL_FILE=/etc/ai-hub/secrets/database_url
COOKIE_SECRET_FILE=/etc/ai-hub/secrets/cookie_secret
DB_PASSWORD_FILE=/etc/ai-hub/secrets/db_password
GARAGE_ADMIN_TOKEN_FILE=/etc/ai-hub/secrets/garage_admin_token
GARAGE_ACCESS_KEY_FILE=/etc/ai-hub/secrets/garage_access_key
GARAGE_SECRET_KEY_FILE=/etc/ai-hub/secrets/garage_secret_key
GARAGE_METRICS_TOKEN_FILE=/etc/ai-hub/secrets/garage_metrics_token
GARAGE_RPC_SECRET_FILE=/etc/ai-hub/secrets/garage_rpc_secret
GARAGE_CONFIG_FILE=/etc/ai-hub/garage/production-primary.toml
TLS_CERT_FILE=/etc/ai-hub/secrets/tls_certificate
TLS_KEY_FILE=/etc/ai-hub/secrets/tls_private_key
