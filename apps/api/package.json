{
  "name": "@ai-hub/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "lint": "eslint src test",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "test": "vitest run",
    "test:input-validation": "vitest run --config vitest.input-validation.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@ai-hub/config": "workspace:*",
    "@ai-hub/database": "workspace:*",
    "@ai-hub/server": "workspace:*",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "^5.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.0"
  },
  "devDependencies": {
    "@ai-hub/testing": "workspace:*",
    "@nestjs/testing": "10.4.22",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "7.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "unplugin-swc": "^1.5.11"
  }
}
